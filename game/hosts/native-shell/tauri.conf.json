{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "夜渡·阴债录",
  "version": "0.5.0",
  "identifier": "com.ghostledger.game",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [{ "label": "main", "title": "夜渡·阴债录", "width": 480, "height": 900, "minWidth": 320, "minHeight": 568 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
