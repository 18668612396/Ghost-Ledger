{
  "name": "ghost-ledger",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "夜渡·阴债录：第一人称地府卡牌原型",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "dev:qa": "node tools/serve.mjs --qa",
    "editor": "node tools/content-editor/server.mjs",
    "preview": "node tools/serve.mjs --dist",
    "check": "node tools/check.mjs",
    "content:check": "node tools/compile-content.mjs",
    "art:check": "node tools/compile-card-art-layout.mjs",
    "check:skins": "node tools/check-skins.mjs",
    "test": "node tools/test.mjs",
    "build": "node tools/build.mjs",
    "package": "node tools/package-targets.mjs",
    "test:playthrough": "node tests/scenarios/act1-release-playthrough.mjs --start 1 --count 12 --width 4 --depth 7 --cover-bosses",
    "test:defeat": "node tests/scenarios/act1-release-playthrough.mjs --seed 1 --passive --resume-every 3",
    "release:check": "node tools/release-preflight.mjs",
    "release:retain": "node tools/retain-release.mjs",
    "release:restore": "node tools/restore-release.mjs"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
